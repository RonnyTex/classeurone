{
    "name": "ronal/ronos.app",
    "autoload": {
        "psr-4": {
            "Domain\\": "src/Domain",
            "Infrastructure\\": "src/Infrastructure",
            "Interface\\": "src/Interface",
            "Application\\": "src/Application",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ronald",
            "email": "ronald.barloy@outlook.com"
        }
    ],
    "require": {
        "psr/http-server-middleware": "^1.0",
        "psr/http-message": "^2.0",
        "guzzlehttp/psr7": "^2.11",
        "http-interop/response-sender": "^1.1",
        "twig/twig": "^3.27",
        "symfony/yaml": "^8.1",
        "symfony/dotenv": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "13",
        "symfony/var-dumper": "^8.1"
    }
}
