<h1>Créer votre établissement</h1>
    <div class="form">
        <form action="" method="post">
            <input type="hidden" name="_csrf" value={{csrf}}>
            <div class="mb-3">
                <label for="lastname" class="form-label">Nom</label>
                <input type="text" class="form-control" id="lastname" name="lastname">
            </div>
            <div class="mb-3">
                <label for="firstname" class="form-label">Prénom</label>
                <input type="text" class="form-control" id="firstname" name="firstname">
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email professionel</label>
                <input type="email" class="form-control" id="email" placeholder="name@example.com" name="email">
            </div>
            <div class="mb-3">
                <select class="form-select" aria-label="fonction" name="role">
                    <option selected>Fonction</option>
                    {% for role in roles %}
                        <option value={{role.id}}>{{role.name}}</option> 
                    {% endfor %}
                </select>
            </div>
            <div class="mb-3">
                <label for="schoolName" class="form-label">Nom de l'école</label>
                <input type="text" class="form-control" id="schoolName" name="school_name">
            </div>
            <div class="mb-3">
                <select class="form-select" aria-label="type" name="school_type">
                    <option selected>Type d'établissement</option>
                    {% for type in types %}
                        <option value={{type.id}}>{{type.name}}</option> 
                    {% endfor %}
                </select>
            </div>
            <div class="mb-3">
                <label for="country" class="form-label">Pays</label>
                <input type="text" class="form-control" id="country" name="country">
            </div>
            <div class="mb-3">
                <label for="city" class="form-label">Ville</label>
                <input type="text" class="form-control" id="city" name="city">
            </div>
            <div class="mb-3">
                <label for="road" class="form-label">Rue</label>
                <input type="text" class="form-control" id="road" name="road">
            </div>
            <div class="mb-3">
                <label for="number" class="form-label">Numéro</label>
                <input type="number" class="form-control" id="number" name="number">
            </div>
            <p>Combien d'éleves comporte votre établissement ?</p>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault1" name="school_radio_capacity">
                <label class="form-check-label" for="radioDefault1">< 100</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault2" name="school_radio_capacity">
                <label class="form-check-label" for="radioDefault2">100 - 300</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault3" name="school_radio_capacity">
                <label class="form-check-label" for="radioDefault3">300 - 500</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault4" name="school_radio_capacity">
                <label class="form-check-label" for="radioDefault4">500 - 1000</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault5" name="school_radio_capacity">
                <label class="form-check-label" for="radioDefault5">1000 - 2000</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="radioDefault" id="radioDefault6" name="school_radio_capacity">
                <label class="form-check-label" for="radioDefault6">> 2000</label>
            </div>
            <div class="mb-3">
                <label for="schoolCapacity" class="form-label">Préciser</label>
                <input type="number" class="form-control" id="schoolCapacity" name="school_capacity">
            </div>
            <button type="submit" class="btn btn-primary">Créer mon école</button>
        </form>
    </div>

{{include('footer.html.twig')}}